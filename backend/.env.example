# Comma-separated frontend origins allowed to call the API.
# Replace the Vercel placeholder with the deployed frontend URL.
BACKEND_CORS_ORIGINS=https://your-project.vercel.app,http://localhost:3000,http://127.0.0.1:3000

# Step 6 defaults to DeepSeek through the OpenAI-compatible SDK.
AI_PROVIDER=deepseek
DEEPSEEK_API_KEY=
AI_MODEL=deepseek-v4-pro

# Reserved for switching AI_PROVIDER to openai in the future.
# Do not commit a real API key.
OPENAI_API_KEY=
